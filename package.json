{
  "name": "eric-task-master",
  "version": "3.0.3",
  "description": "A local, durable Chrome task runner for AI agents: write one script, run one command, stream results.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "taskmaster": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs manager foreground",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:dashboard": "node scripts/dashboard-acceptance.mjs",
    "build:bundle": "node scripts/build/build-bundle.mjs",
    "check": "node scripts/check.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "node --test --test-concurrency=1 test-v3/*.test.mjs"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
