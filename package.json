{
  "name": "eric-task-master",
  "version": "2.0.0",
  "description": "Playwright browser automation runtime for AI agents with MCP, persistent Profiles, durable tasks, and unattended workflows.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "taskmaster": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs serve",
    "connect": "node src/cli.mjs connect",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:commercial": "node scripts/commercial-acceptance.mjs",
    "check": "node scripts/check.mjs",
    "mcp": "node src/mcp/stdio.mjs",
    "mcp:register": "node scripts/register-mcp.mjs install --json",
    "mcp:status": "node scripts/register-mcp.mjs status --json",
    "mcp:unregister": "node scripts/register-mcp.mjs uninstall --json",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
