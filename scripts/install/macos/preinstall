#!/bin/sh
set -eu

app_root='/Library/Application Support/Eric Task Master'
old_cli="${app_root}/bin/taskmaster"
cli_link='/usr/local/bin/taskmaster'

runtime_pids() {
  processes="$(ps -ax -o pid= -o command=)" || return 1
  printf '%s\n' "${processes}" | awk \
    -v node_path="${app_root}/runtime/node" '
      index($0, node_path) { print $1 }
    '
}

if [ -e "${app_root}" ]; then
  if [ ! -x "${old_cli}" ]; then
    echo 'Eric Task Master upgrade stopped: the previous application launcher is missing.' >&2
    exit 1
  fi
  pids="$(runtime_pids)"
  if [ -n "${pids}" ]; then
    echo 'Eric Task Master upgrade stopped: runtime is still in use. No Agent was stopped; explicitly stop the idle Manager before retrying.' >&2
    exit 1
  fi
  rm -rf "${app_root}"
fi

if [ -L "${cli_link}" ] && [ "$(readlink "${cli_link}")" = "${old_cli}" ]; then
  rm -f "${cli_link}"
fi

exit 0
